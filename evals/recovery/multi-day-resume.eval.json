{
  "id": "recovery/multi-day-resume",
  "description": "Aged wave-2 in-flight + stale session.json: resume reconstructs HOLD; of init without --force dies",
  "fixture": "recovery_multi_day_resume",
  "tags": ["recovery", "resume", "gate"],
  "steps": [
    {
      "run": "resume",
      "exit": 0,
      "stdout_contains": [
        "wave          2",
        "field         open",
        "auto_continue yes",
        "in_flight",
        "  w2",
        "    residual    MISSING",
        "parked_reason scratch_active",
        "next",
        "HOLD",
        "continue existing packets; do not repack"
      ],
      "stdout_not_contains": [
        "field         closed",
        "signal        abandoned",
        "no ORDER",
        "  domain",
        "next\n  PACK",
        "auto_continue no",
        "foreign field"
      ]
    },
    {
      "run": "init",
      "args": ["--mission", "re-init theater"],
      "exit": 1,
      "stderr_contains": ["field(s) exist"]
    },
    {
      "run": "status",
      "exit": 0,
      "stdout_contains": ["wave        2", "multi-day live wave"],
      "stdout_not_contains": ["signal      abandoned", "no ORDER"]
    }
  ]
}
