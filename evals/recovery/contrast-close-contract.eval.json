{
  "id": "recovery/contrast-close-contract",
  "description": "Public-surface CLI-001: slogan/internal/child stamp cannot close; VERIFIED_CONTRACT then RESOLVED then CLOSED",
  "fixture": "recovery_contrast_close_contract",
  "tags": ["recovery", "gate", "contrast", "contract"],
  "steps": [
    {
      "run": "collect",
      "args": ["--wave", "1"],
      "exit": 0
    },
    {
      "run": "integrate",
      "args": ["--wave", "1", "--apply"],
      "exit": 0
    },
    {
      "run": "contrast",
      "exit": 2,
      "stdout_contains": [
        "CLOSE BLOCKED",
        "DELIVERED",
        "CLI-001",
        "\"id\": \"CLI-001\"",
        "\"verdict\": \"DELIVERED\"",
        "\"gate\": \"CLOSE_BLOCKED\"",
        "\"blocking\": true"
      ]
    },
    {
      "run": "close",
      "exit": 1,
      "stderr_contains": ["of close refused"]
    },
    {
      "run": "spec",
      "args": ["--verified-internal", "CLI-001"],
      "exit": 0
    },
    {
      "run": "contrast",
      "exit": 2,
      "stdout_contains": [
        "CLOSE BLOCKED",
        "VERIFIED_INTERNAL",
        "CLI-001",
        "\"id\": \"CLI-001\"",
        "\"verdict\": \"VERIFIED_INTERNAL\"",
        "\"gate\": \"CLOSE_BLOCKED\""
      ]
    },
    {
      "run": ["--json", "contrast"],
      "exit": 2,
      "stdout_contains": ["CLOSE BLOCKED", "CLI-001", "VERIFIED_INTERNAL"],
      "stderr_contains": [
        "\"event\": \"contrast\"",
        "\"id\": \"CLI-001\"",
        "\"verdict\": \"VERIFIED_INTERNAL\"",
        "\"gate\": \"CLOSE_BLOCKED\""
      ]
    },
    {
      "run": "close",
      "exit": 1,
      "stderr_contains": ["of close refused", "VERIFIED_INTERNAL"]
    },
    {
      "run": "spec",
      "args": ["--verified-contract", "CLI-001"],
      "exit": 0
    },
    {
      "run": "contrast",
      "exit": 0,
      "stdout_contains": [
        "RESOLVED",
        "VERIFIED_CONTRACT",
        "\"gate\": \"RESOLVED\"",
        "\"verdict\": \"VERIFIED_CONTRACT\""
      ]
    },
    {
      "run": "close",
      "exit": 0,
      "stdout_contains": ["CLOSED"],
      "file_contains": [
        {
          "path": ".orderfield/CLOSE.json",
          "contains": ["\"verdict\": \"RESOLVED\"", "\"done_when_closed\": true"]
        }
      ]
    },
    {
      "run": "status",
      "exit": 0,
      "stdout_contains": ["done_when_closed True"]
    }
  ]
}
