{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orderfield/residual.schema.json",
  "title": "Orderfield residual",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "result_ref", "residual", "metrics"],
  "properties": {
    "packet_id": { "type": "string" },
    "packet_hash": { "type": "string" },
    "order_id": { "type": "string" },
    "order_rev": { "type": "integer", "minimum": 1 },
    "wave": { "type": "integer", "minimum": 1 },
    "child_id": { "type": "string" },
    "role": { "type": "string" },
    "status": { "type": "string", "enum": ["done", "blocked", "threshold"] },
    "result_ref": { "type": "string" },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wants_to_change", "evidence", "proposed_patch"],
      "properties": {
        "wants_to_change": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["mission", "phase", "constraints", "done_when", "workspace"]
          }
        },
        "evidence": { "type": "string" },
        "proposed_patch": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "constraints+": {
              "type": "array",
              "items": { "type": "string" }
            },
            "done_when+": {
              "type": "array",
              "items": { "type": "string" }
            },
            "notes": { "type": "string" },
            "done_when_closed": { "type": "boolean" },
            "requirements_verified": {
              "type": "array",
              "items": { "type": "string" }
            },
            "requirements_failed": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty", "divergence", "tool_failures", "novelty"],
      "properties": {
        "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
        "divergence": { "type": "number", "minimum": 0, "maximum": 1 },
        "tool_failures": { "type": "integer", "minimum": 0 },
        "novelty": { "type": "boolean" }
      }
    }
  }
}
