{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orderfield/order.schema.json",
  "title": "Orderfield ORDER",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "rev", "mission", "phase", "done_when", "constraints", "workspace", "thresholds", "caps", "enabled_regimes"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "rev": { "type": "integer", "minimum": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["explore", "cut", "build", "verify", "deliver"]
    },
    "done_when": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readable", "writable_by_slaves", "forbidden"],
      "properties": {
        "readable": { "type": "array", "items": { "type": "string" } },
        "writable_by_slaves": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_failures", "divergence", "local_budget_pct", "novelty"],
      "properties": {
        "tool_failures": { "type": "integer", "minimum": 1 },
        "divergence": { "type": "number", "minimum": 0, "maximum": 1 },
        "local_budget_pct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "novelty": { "type": "boolean" }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_children", "max_depth", "max_across_per_wave", "cooldown_waves_after_across"],
      "properties": {
        "max_children": { "type": "integer", "minimum": 1 },
        "max_depth": { "type": "integer", "minimum": 1 },
        "max_across_per_wave": { "type": "integer", "minimum": 0 },
        "cooldown_waves_after_across": { "type": "integer", "minimum": 0 }
      }
    },
    "enabled_regimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["escalate_up", "scale_out", "scale_across", "scale_up", "human", "hold", "phase"]
      }
    },
    "done_when_closed": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
