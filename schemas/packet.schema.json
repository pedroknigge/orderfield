{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orderfield/packet.schema.json",
  "title": "Orderfield slaving packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "order_rev", "order", "slice", "role", "residual_path", "scratch_dir", "budget"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "pattern": "^pkt_[0-9a-f]{32}$" },
    "packet_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wave": { "type": "integer", "minimum": 1 },
    "child_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "packed_at": { "type": "string", "minLength": 1 },
    "order_id": { "type": "string", "minLength": 1 },
    "order_rev": { "type": "integer", "minimum": 1 },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rev", "mission", "phase", "done_when", "constraints", "workspace", "thresholds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rev": { "type": "integer", "minimum": 1 },
        "mission": { "type": "string", "minLength": 1 },
        "phase": {
          "type": "string",
          "enum": ["explore", "cut", "build", "verify", "deliver"]
        },
        "done_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readable", "writable_by_slaves", "forbidden"],
          "properties": {
            "readable": { "type": "array", "items": { "type": "string" } },
            "writable_by_slaves": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Frozen protocol key. Aliases migrate onto this name; do not rename without a versioned migration."
            },
            "forbidden": { "type": "array", "items": { "type": "string" } }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_failures", "divergence", "local_budget_pct", "novelty"],
          "properties": {
            "tool_failures": { "type": "integer", "minimum": 1 },
            "divergence": { "type": "number", "minimum": 0, "maximum": 1 },
            "local_budget_pct": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Reserved; not evaluated."
            },
            "novelty": { "type": "boolean" }
          }
        },
        "backlog": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "spec_ref": { "type": "string", "minLength": 1 },
        "spec_hash": { "type": "string", "minLength": 1 }
      }
    },
    "spec_ref": { "type": "string", "minLength": 1 },
    "spec_hash": { "type": "string", "minLength": 1 },
    "owns_requirements": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{3}$" }
    },
    "reads_spec": { "type": "boolean" },
    "slice": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "enum": ["explorer", "implementer", "adversary", "synthesizer", "verifier"]
    },
    "residual_path": { "type": "string", "minLength": 1 },
    "scratch_dir": { "type": "string", "minLength": 1 },
    "allow_nested": { "type": "boolean", "default": false },
    "requires_tool": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "seconds"],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Reserved; carried in packets but not measured or enforced."
        },
        "seconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
