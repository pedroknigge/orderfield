{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orderfield/session.schema.json",
  "title": "Orderfield session snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["wave", "last_cmd", "in_flight", "updated_at"],
  "properties": {
    "wave": { "type": "integer", "minimum": 1 },
    "last_cmd": { "type": "string", "minLength": 1 },
    "in_flight": {
      "type": "array",
      "items": { "type": "string" }
    },
    "in_flight_detail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["child_id", "role", "packed_at", "slice"],
        "properties": {
          "child_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "packed_at": { "type": ["string", "null"], "minLength": 1 },
          "slice": { "type": "string" }
        }
      }
    },
    "updated_at": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" }
  }
}
